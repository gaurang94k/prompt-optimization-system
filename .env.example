# Copy this file to .env and fill in your values
# .env is gitignored — your secrets stay local

# Required: Your Google Gemini API key
# Get one free at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Password-protect the app (recommended for public deployment)
# Leave empty or remove this line for open access (local dev)
APP_PASSWORD=your-secret-password-here
